ifdef KBUILD_EXTMOD
ifeq ($(CONFIG_MYSU_DISABLE_MANAGER),y)
ccflags-y += -DCONFIG_MYSU_DISABLE_MANAGER=1
endif
ifeq ($(CONFIG_MYSU_DISABLE_POLICY),y)
ccflags-y += -DCONFIG_MYSU_DISABLE_POLICY=1
endif
ifeq ($(CONFIG_MYSU_DEBUG),y)
ccflags-y += -DCONFIG_MYSU_DEBUG=1
endif
ifeq ($(CONFIG_MYSU_X86_PATCH_SYSCALL_DISPATCHER),y)
